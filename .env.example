# Copy this file to `.env` (git-ignored) and adjust values, then run:
#   docker compose up --build -d
#
# All variables are optional — the defaults below keep a local demo working.

# JWT signing secret for the API. CHANGE THIS for any real deployment.
JWT_SECRET=tongtin-dev-secret-key-change-me-in-production-0123456789abcdef

# Set to "true" to seed demo data on API boot (Host 0900111001 / Member 0900100001, password demo1234).
APP_SEED_DEMO=false

# URL the web container uses to reach the API inside the compose network.
# Baked into the web image at build time — rebuild the web image after changing it.
API_INTERNAL_URL=http://api:8080
